{
  "name": "@elefin/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "migrate": "migrate-mongo up -f migrate-mongo-config.cjs",
    "migrate:down": "migrate-mongo down -f migrate-mongo-config.cjs",
    "migrate:status": "migrate-mongo status -f migrate-mongo-config.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "migrate-mongo": "^11.0.0",
    "mongodb": "^6.12.0",
    "typescript": "^5.7.3"
  }
}
