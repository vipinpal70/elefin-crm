# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# --- MongoDB -------------------------------------------------
# Local docker-compose default:
MONGODB_URI=mongodb://root:example@localhost:27017/elefin_crm?authSource=admin
MONGODB_DB=elefin_crm

# --- Elefin Client Data API --------------------------------
# Issued once by Elefin. Server-side only. The two halves joined by a dot
# form the Bearer token: "Authorization: Bearer <KEY>.<SECRET>".
ELEFIN_API_BASE_URL=https://el.theloginarea.com/api/v1
ELEFIN_API_KEY=fxcrm_pk_xxxxxxxx
ELEFIN_API_SECRET=fxcrm_sk_xxxxxxxx
# Requests/minute the key is allowed (see /me → key.rate_limit_per_minute).
ELEFIN_RATE_LIMIT_PER_MIN=60

# --- Web app auth -----------------------------------------
# 32+ random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=12
# Seed owner created by `npm run db:seed` (only if no users exist yet)
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-now
SEED_OWNER_NAME=Owner

# --- Worker ----------------------------------------------
# Cron expressions (UTC). Empty = disabled.
SYNC_CLIENTS_CRON=*/15 * * * *
# Full per-account sweep (~1 API call per client). Keep this infrequent.
SYNC_ACCOUNTS_CRON=17 */6 * * *
# Book-wide deposit/withdrawal ledger — cheap (2 calls), safe to run often.
SYNC_TRANSACTIONS_CRON=*/20 * * * *
# Per-account closed trades (only accounts that have traded).
SYNC_TRADES_CRON=8 * * * *
# Per-account open positions (~1 API call per account with risk).
SYNC_POSITIONS_CRON=*/2 * * * *
SNAPSHOT_CRON=5 0 * * *
# Generate the action-item alerts. Cheap (a handful of aggregations).
ALERTS_CRON=*/15 * * * *
# Daily summary (stored + optional webhook). 07:00 UTC.
DIGEST_CRON=0 7 * * *
# Optional: POST the digest as {text,...} — Slack/Discord/Telegram-bridge compatible.
DIGEST_WEBHOOK_URL=
# Run /me + sync-clients once on boot (the long sweeps wait for their cron).
WORKER_RUN_ON_BOOT=true

# --- Misc ------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
TZ=UTC
